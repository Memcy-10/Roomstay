          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login admin responde 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('JWT admin existe', function () { pm.expect(json.data.token).to.be.a('string').and.not.empty; });",
                  "pm.test('Rol admin', function () { pm.expect(json.data.user.role).to.eql('admin'); });",
                  "pm.collectionVariables.set('adminToken', json.data.token);"
                ]
              }
            }
