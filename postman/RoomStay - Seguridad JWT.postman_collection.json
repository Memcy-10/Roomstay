    {
      "name": "02 - Login y JWT",
      "item": [
        {
          "name": "Login administrador y guardar JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
